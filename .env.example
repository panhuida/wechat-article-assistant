# Flask配置
FLASK_APP=src.wechat_article_assistant.app
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here
FLASK_PORT=5000

# 数据库配置
# SQLite (默认)
DATABASE_URL=sqlite:///data/wechat_assistant.db
# PostgreSQL 示例
# DATABASE_URL=postgresql://demo:demo@192.168.31.72:5432/wechat_assistant

# 日志配置
LOG_LEVEL=INFO
LOG_DIR=logs

# 下载配置
DOWNLOAD_DIR=data/downloads

# 微信公众平台配置
WECHAT_MP_URL=https://mp.weixin.qq.com
SESSION_FILE=data/wechat_session.json

# 登录方式配置
# popup: 在Web应用中弹窗显示二维码（推荐，不启动可见浏览器）
# browser: 启动Playwright浏览器窗口扫码登录
LOGIN_MODE=popup

# 每日公众号摘要自动化配置
DAILY_DIGEST_OUTPUT_DIR=/home/pan/文摘/公众号
DAILY_DIGEST_EMAIL_TO=panhuida@qq.com
DAILY_DIGEST_CODEX_MODEL=gpt-5.4
DAILY_DIGEST_SMTP_USER=your-smtp-user@example.com
DAILY_DIGEST_SMTP_PASSWORD=your-smtp-password
DAILY_DIGEST_SMTP_HOST=smtp.example.com
